generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  password   String
  name       String
  rm         Int
  curso      String
  funcao     String
  telNumero  String
  produto    Produto[]
  interesses Interesse[]
}

model Produto {
  id              Int         @id @default(autoincrement())
  name            String
  preco           Float
  condicao        Int
  imagem          String      // armazenará JSON string das imagens
  descricao       String
  disponibilidade Boolean
  userId          Int
  localId         Int
  horarioId       Int
  user            User        @relation(fields: [userId], references: [id])
  local           Local       @relation(fields: [localId], references: [Id])
  horario         Horario     @relation(fields: [horarioId], references: [id])
  interesses      Interesse[]
}

model Interesse {
  id        Int      @id @default(autoincrement())
  userId    Int
  produtoId Int
  horarioId Int
  localId   Int
  status    String   @default("pendente")
  createdAt DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])
  horario Horario @relation(fields: [horarioId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  local   Local   @relation(fields: [localId], references: [Id])
}

model Local {
  Id         Int         @id @default(autoincrement())
  local      String      // armazenará JSON string do array de locais
  produtos   Produto[]
  interesses Interesse[]
}

model Horario {
  id         Int         @id @default(autoincrement())
  horario    String      // armazenará JSON string do array de horários
  interesses Interesse[]
  produtos   Produto[]
}